---
import { getCollection } from "astro:content";
import Forum from "../../layouts/Forum.astro";
import { postDate } from "../../format";

const posts = (await getCollection("writing")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Forum title="writing — andrew" description="writing by andrew." tab="writing">
  <section class="panel">
    <div class="bar"><h1>writing</h1><small>{posts.length} {posts.length === 1 ? "post" : "posts"}</small></div>
    <table>
      <thead><tr><th>thread</th><th class="num">replies</th></tr></thead>
      <tbody>
        {posts.length === 0 && <tr><td>nothing here yet.</td><td class="num">—</td></tr>}
        {posts.map((post) => (
          <tr>
            <td><a class="title" href={`/writing/${post.id}/`}>{post.data.title}</a><span class="by">started by andrew · {postDate(post.data.date)}</span></td>
            <td class="num">—</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Forum>
