---
// The forum index: writing fills the main column; the profile and who's online sit in the sidebar.
import { getCollection } from "astro:content";
import Forum from "../layouts/Forum.astro";
import Postbit from "../components/Postbit.astro";
import { postDate } from "../format";

const posts = (await getCollection("writing")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Forum title="andrew" description="andrew — building voluma, prev epic.">
  <section class="panel threads" aria-label="writing">
    <table>
      <thead><tr><th>thread</th><th class="last">last post</th></tr></thead>
      <tbody>
        {posts.length === 0 && <tr><td>nothing here yet.</td><td class="last">—</td></tr>}
        {posts.map((post) => (
          <tr>
            <td><a class="title" href={`/writing/${post.id}/`}>{post.data.title}</a><span class="by">started by andrew</span></td>
            <td class="last">{postDate(post.data.date)}<span class="by">by andrew</span></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="panel me">
    <div class="bar"><h1>profile</h1></div>
    <div class="body profile">
      <Postbit />
      <div>
        <div class="row">
          <span class="label">building</span>
          <span><a class="gel company voluma" href="https://voluma.bio/" aria-label="voluma"><img src="/assets/voluma-wordmark.png" alt="" width="320" height="53"></a></span>
        </div>
        <div class="row">
          <span class="label">prev</span>
          <span><a class="gel company epic" href="https://www.epic.com/" aria-label="epic"><img src="/assets/epic-wordmark.png" alt="" width="106" height="41"></a>
            <a class="gel company intel" href="https://www.intel.com/" aria-label="intel"><img src="/assets/intel-wordmark.png" alt="" width="206" height="80"></a></span>
        </div>
      </div>
    </div>
  </section>

  <section class="panel side">
    <div class="bar"><h2>who's online</h2></div>
    <div class="body online">
      <p id="online-count" aria-live="polite">1 member online</p>
      <p class="members"><span class="status admin" title="administrator">andrew</span></p>
    </div>
  </section>
</Forum>
