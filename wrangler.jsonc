{
  "name": "andrewtea-online",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",
  // Astro builds the site into dist/ (wrangler runs the build before deploy and dev),
  // and dist/ is served as static assets; only the guest counter at /online runs Worker code.
  "build": { "command": "npm run build" },
  "assets": { "directory": "./dist", "run_worker_first": ["/online"] },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }]
}
