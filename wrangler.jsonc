{
  "name": "andrewtea-online",
  "main": "worker/src/index.js",
  "compatibility_date": "2026-11-01",
  // The site's files are served straight from the repo root (see .assetsignore);
  // only the guest counter at /online runs Worker code.
  "assets": { "directory": ".", "run_worker_first": ["/online"] },
  "durable_objects": {
    "bindings": [{ "name": "PRESENCE", "class_name": "Presence" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Presence"] }]
}
